# ============================================================================
# CostPro — Variables de entorno (PLANTILLA — copiar a .env y rellenar)
# ============================================================================
# ⚠️ NO commitear credenciales reales. Este archivo es solo una plantilla.

# Database (Prisma)
DATABASE_URL=file:./db/custom.db

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE
SUPABASE_ACCESS_TOKEN=YOUR_ACCESS_TOKEN_HERE

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SECURITY: Dev bypass MUST be false in production.
ENABLE_DEV_BYPASS=false

# CSRF: Comma-separated allowed domains
# Development:
CSRF_ALLOWED_DOMAINS=.space-z.ai
# Production:
#   CSRF_ALLOWED_DOMAINS=yourdomain.com,*.vercel.app,.space-z.ai

# AI Providers
ZAI_API_KEY=your-zai-api-key-here
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=your-openai-api-key-here
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# App
NODE_ENV=development
PORT=3000

# Vercel (opcional)
VERCEL_TOKEN=your-vercel-token-here

# Sentry (opcional)
SENTRY_DSN=

# OpenTelemetry (opcional)
OTEL_ENABLED=false

# Rate Limit (V1.1: OBLIGATORIO en producción serverless)
UPSTASH_REDIS_REST_URL=your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# ── V2-ONLY (REM-V2-1) ──────────────────────────────────────────────────────
# Flags de migración V1→V2. Valores permitidos: "true" | "false" (exactos).
# REM-V2-1: el estado objetivo del producto es V2 ONLY:
#   NEXT_PUBLIC_USE_V2_CHECKOUT=true  → POS usa /api/pos/checkout (create_sale_v2)
#   NEXT_PUBLIC_USE_V2_REVERSE=true   → /api/reverse y /api/devolutions usan RPCs v2
# ⚠️ "false" restaura caminos V1 (fallback). No desplegar producción con false.
# NEXT_PUBLIC_* son visibles al cliente: nunca almacenar secretos aquí.
NEXT_PUBLIC_USE_V2_CHECKOUT=true
NEXT_PUBLIC_USE_V2_REVERSE=true
# Tiendas en piloto para checkout V2 (CSV de UUIDs; vacío = todas):
NEXT_PUBLIC_V2_CHECKOUT_PILOT_STORES=
