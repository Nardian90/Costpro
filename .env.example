# ============================================================================
# CostPro — Variables de entorno (PLANTILLA — copiar a .env y rellenar)
# ============================================================================
# ⚠️ NO commitear credenciales reales. Este archivo es solo una plantilla.

# Database (Prisma)
DATABASE_URL=file:./db/custom.db

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE
SUPABASE_ACCESS_TOKEN=YOUR_ACCESS_TOKEN_HERE

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SECURITY: Dev bypass MUST be false in production.
ENABLE_DEV_BYPASS=false

# CSRF: Comma-separated allowed domains
# Development:
CSRF_ALLOWED_DOMAINS=.space-z.ai
# Production:
#   CSRF_ALLOWED_DOMAINS=yourdomain.com,*.vercel.app,.space-z.ai

# AI Providers
ZAI_API_KEY=your-zai-api-key-here
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=your-openai-api-key-here
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# App
NODE_ENV=development
PORT=3000

# Vercel (opcional)
VERCEL_TOKEN=your-vercel-token-here

# Sentry (opcional)
SENTRY_DSN=

# OpenTelemetry (opcional)
OTEL_ENABLED=false

# Rate Limit (V1.1: OBLIGATORIO en producción serverless)
UPSTASH_REDIS_REST_URL=your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# ── E2E RUNNER ISOLATION (chore/e2e-runner-isolation) ───────────────────────
# Aislamiento por ejecución: cada corrida de la suite (local o CI) obtiene
# usuarios + tenant + tiendas piloto propios (ver e2e/fixtures/run-env.ts).
#   E2E_ISOLATION=0        → modo legacy compartido (usuarios demo fijos +
#                            pilotos persistentes por nombre exacto)
#   E2E_RUN_ID             → identidad del run (autogenerada si no se fija;
#                            el orquestador de concurrencia la presetdea)
#   E2E_RUN_TENANT_ID      → (interno) tenant del run, exportado a los workers
#   E2E_PEER_RUN_CONTEXT   → (interno) context JSON del run peer para la
#                            prueba de aislamiento cruzado
E2E_ISOLATION=1

# ── E2E BD AISLADA "CostproE2E" (CP-INFRA-011) ──────────────────────────────
# Variables LÓGICAS que consumen e2e/fixtures/assert-isolated-db.ts y los
# scripts de scripts/e2e/ (check-e2e-config, verify-remote-e2e, apilador).
# El guard rechaza fail-closed el ref de producción (wthkddeleylijmonclxg):
# exige que el ref de la URL coincida EXACTAMENTE con E2E_ALLOWED_REMOTE_REF
# y que el centinela public.e2e_is_isolated_db() devuelva true.
# Valores REALES: SOLO en los secretos del Environment `e2e-isolated` de
# GitHub o en el .env LOCAL (jamás versionados — .env* está en .gitignore).
E2E_SUPABASE_URL=https://YOUR-E2E-PROJECT.supabase.co
E2E_SUPABASE_ANON_KEY=YOUR_E2E_ANON_KEY_HERE
E2E_SUPABASE_SERVICE_ROLE_KEY=YOUR_E2E_SERVICE_ROLE_KEY_HERE
E2E_ALLOWED_REMOTE_REF=YOUR_E2E_PROJECT_REF_HERE
E2E_TARGET_KIND=project
# Cadena Postgres directa del proyecto aislado (transporte pg del apilador)
E2E_SUPABASE_DB_URL=postgresql://postgres:YOUR_E2E_DB_PASSWORD@db.YOUR_E2E_PROJECT_REF.supabase.co:5432/postgres
# Los recursos protegidos de producción NO existen (ni deben existir) en la
# base aislada — ver .github/workflows/e2e-isolated.yml
E2E_SKIP_PROTECTED_GUARD=1

# ── V2-ONLY (FINALIZE-V2) ────────────────────────────────────────────────────
# FINALIZE-V2: los flags de migración V1→V2 fueron ELIMINADOS del producto:
#   NEXT_PUBLIC_USE_V2_CHECKOUT / NEXT_PUBLIC_USE_V2_REVERSE /
#   NEXT_PUBLIC_V2_CHECKOUT_PILOT_STORES ya no existen ni tienen efecto.
# create_sale_v2 y create_devolution_v2 son los únicos caminos soportados
# (las funciones V1 fueron retiradas de la base de datos). Cualquier valor
# residual de estas variables en un .env viejo es ignorado sin efecto.
