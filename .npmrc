# Vercel + local: permitir peer deps conflictivos sin romper el build.
# Especificamente: @zxing/browser@0.2.1 pide @zxing/library@^0.23.0 pero
# el root tiene @zxing/library@^0.22.0. Estabanda funciona en runtime
# (la API usada es compatible entre 0.22 y 0.23) — solo npm strict lo rechaza.
# Esta es la solucion documentada por Vercel para conflictos de peer deps.
legacy-peer-deps=true
