════════ 3. FASE 3 — parche + forense POST (w7d1-acl-patch.sql + tmp/w7d1-f3-post-patch.out) ════════
-- ============================================================================
-- w7d1-acl-patch.sql — W7-D1 ACL REMEDIATION (enmienda al paquete 01)
-- Orden: GO W7-D1 ACL REMEDIATION + RE-GATE (sesión de laboratorio, clon efímero)
-- PRODUCCIÓN CONGELADA: este parche NUNCA se aplica a producción sin orden
--   explícita del dueño; su aplicación aquí es exclusivamente en clon de prueba.
--
-- Problema (W7-03 §12.2): CREATE FUNCTION otorga EXECUTE a PUBLIC por defecto;
-- el paquete 01 añadió GRANT a service_role pero nunca revocó PUBLIC/anon/
-- authenticated → mutación arbitraria de WAC reproducible por roles de cliente.
--
-- Firma verificada en pg_proc ANTES de este parche (FASE 1, sin overloads):
--   public.fn_recalc_wac(p_store_id uuid, p_product_id uuid, p_event text,
--                        p_qty_in numeric, p_uc_in numeric,
--                        p_source_ref jsonb DEFAULT NULL) RETURNS numeric
--   SECURITY DEFINER, SET search_path TO 'public','extensions', owner postgres
--
-- Principio de mínimo privilegio (FASE 4):
--   PUBLIC        = DENY   (nunca fue intención; default de PostgreSQL)
--   anon          = DENY   (rol de identidad anónima de PostgREST)
--   authenticated = DENY   (el writer se invoca INTERNAMENTE por 12 rutinas
--                           SECURITY DEFINER owner postgres — la cadena
--                           consumer→canonical writer no necesita EXECUTE
--                           directo del rol cliente)
--   service_role  = KEEP   (rol de confianza server-side; GRANT ya emitido por
--                           pkg 01 L838; único caso de uso externo legítimo:
--                           recalculo administrativo vía RPC server-side)
--   postgres      = KEEP   (owner; bypass intrínseco)
-- ============================================================================

BEGIN;

REVOKE EXECUTE ON FUNCTION public.fn_recalc_wac(uuid,uuid,text,numeric,numeric,jsonb) FROM PUBLIC;
REVOKE EXECUTE ON FUNCTION public.fn_recalc_wac(uuid,uuid,text,numeric,numeric,jsonb) FROM anon;
REVOKE EXECUTE ON FUNCTION public.fn_recalc_wac(uuid,uuid,text,numeric,numeric,jsonb) FROM authenticated;

COMMIT;
--- post-patch ---
F1|IDENT|public.fn_recalc_wac(p_store_id uuid, p_product_id uuid, p_event text, p_qty_in numeric, p_uc_in numeric, p_source_ref jsonb)|ret=numeric|secdef=true|owner=postgres|search_path={"search_path=public, extensions"}|proacl=postgres=X/postgres,service_role=X/postgres
F1|OVERLOADS|count=1|fn_recalc_wac(uuid,uuid,text,numeric,numeric,jsonb)
F1|ROUTINE_PRIV|grantee=postgres|priv=EXECUTE
F1|ROUTINE_PRIV|grantee=service_role|priv=EXECUTE
F1|HFP|anon=false|authenticated=false|service_role=true|postgres(owner)=true
F1|ROLE|anon|canlogin=false|super=false
F1|ROLE|authenticated|canlogin=false|super=false
F1|ROLE|authenticator|canlogin=false|super=false
F1|ROLE|postgres|canlogin=true|super=true
F1|ROLE|service_role|canlogin=false|super=false
F1|CALLER|cancel_reception(p_reception_id uuid)|secdef=true|acl=postgres=X/postgres,authenticated=X/postgres,service_role=X/postgres
F1|CALLER|confirm_pending_reception(p_receipt_id uuid, p_user_id uuid, p_operation_date timestamp with time zone)|secdef=true|acl=postgres=X/postgres,authenticated=X/postgres,service_role=X/postgres
F1|CALLER|confirm_transfer(p_transfer_id uuid, p_user_id uuid, p_operation_date timestamp with time zone)|secdef=true|acl=postgres=X/postgres,authenticated=X/postgres,service_role=X/postgres
F1|CALLER|fn_process_receipt(p_items jsonb, p_user_id uuid, p_reference text)|secdef=true|acl=postgres=X/postgres,authenticated=X/postgres,service_role=X/postgres
F1|CALLER|fn_process_receipt(p_items jsonb, p_user_id uuid, p_store_id uuid, p_reference text)|secdef=true|acl=postgres=X/postgres,authenticated=X/postgres,service_role=X/postgres
F1|CALLER|perform_inventory_adjustment(p_store_id uuid, p_product_id uuid, p_quantity_delta numeric, p_reason text, p_user_id uuid, p_unit_cost_adjustment numeric, p_operation_date timestamp with time zone)|secdef=true|acl=postgres=X/postgres,authenticated=X/postgres,service_role=X/postgres
F1|CALLER|receive_production_output(p_order_id uuid, p_product_id uuid, p_quantity numeric, p_store_id uuid, p_user_id uuid, p_idempotency_key text)|secdef=true|acl=postgres=X/postgres,authenticated=X/postgres,service_role=X/postgres
F1|CALLER|reverse_production_order(p_order_id uuid, p_reason text, p_user_id uuid)|secdef=true|acl==X/postgres,postgres=X/postgres,anon=X/postgres,authenticated=X/postgres,service_role=X/postgres
