  "constraints": [
    {
      "table_name": "inventory",
      "conname": "inventory_pkey",
      "def": "PRIMARY KEY (id)"
    },
    {
      "table_name": "inventory",
      "conname": "inventory_product_id_fkey",
      "def": "FOREIGN KEY (product_id) REFERENCES products(id) ON DELETE CASCADE"
    },
    {
      "table_name": "inventory",
      "conname": "inventory_store_id_fkey",
      "def": "FOREIGN KEY (store_id) REFERENCES stores(id) ON DELETE CASCADE"
    },
    {
      "table_name": "inventory",
      "conname": "inventory_store_id_product_id_key",
      "def": "UNIQUE (store_id, product_id)"
    },
    {
      "table_name": "inventory",
      "conname": "inventory_tenant_id_fkey",
      "def": "FOREIGN KEY (tenant_id) REFERENCES tenants(id)"
    },
    {
      "table_name": "inventory",
      "conname": "stock_non_negative",
      "def": "CHECK ((quantity >= (0)::numeric))"
    },
    {
      "table_name": "purchase_items",
      "conname": "purchase_items_pkey",
      "def": "PRIMARY KEY (id)"
    },
    {
      "table_name": "purchase_items",
