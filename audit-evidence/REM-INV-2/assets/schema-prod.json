    },
    {
      "table_name": "purchase_items",
      "conname": "purchase_items_purchase_order_id_fkey",
      "def": "FOREIGN KEY (purchase_order_id) REFERENCES purchase_orders(id) ON DELETE CASCADE"
    },
    {
      "table_name": "purchase_items",
      "conname": "purchase_items_quantity_check",
      "def": "CHECK ((quantity > (0)::numeric))"
    },
    {
      "table_name": "purchase_items",
      "conname": "purchase_items_unit_cost_check",
      "def": "CHECK ((unit_cost >= (0)::numeric))"
    },
    {
      "table_name": "purchase_orders",
      "conname": "purchase_orders_created_by_fkey",
      "def": "FOREIGN KEY (created_by) REFERENCES auth.users(id)"
    },
    {
      "table_name": "purchase_orders",
      "conname": "purchase_orders_pkey",
      "def": "PRIMARY KEY (id)"
    },
    {
      "table_name": "purchase_orders",
      "conname": "purchase_orders_store_id_fkey",
      "def": "FOREIGN KEY (store_id) REFERENCES stores(id)"
    },
    {
      "table_name": "purchase_orders",
      "conname": "purchase_orders_supplier_id_fkey",
      "def": "FOREIGN KEY (supplier_id) REFERENCES suppliers(id) ON DELETE SET NULL"
    },
    {
      "table_name": "stock_movements",
      "conname": "stock_movements_created_by_fkey",
      "def": "FOREIGN KEY (created_by) REFERENCES auth.users(id) ON DELETE SET NULL"
    },
    {
      "table_name": "stock_movements",
      "conname": "stock_movements_pkey",
