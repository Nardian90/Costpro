 "triggers": [
  {
   "table_name": "devolutions",
   "tgname": "trg_validate_devolution_transition",
   "tgenabled": "O",
   "def": "CREATE TRIGGER trg_validate_devolution_transition BEFORE UPDATE OF status ON public.devolutions FOR EACH ROW EXECUTE FUNCTION fn_validate_document_transition('devolutions')",
   "fn_name": "fn_validate_document_transition",
   "fn_secdef": false,
   "fn_owner": "postgres"
  }
 ],
 "constraints": [
  {
   "table_name": "devolution_items",
   "conname": "devolution_items_quantity_check",
   "contype": "c",
   "def": "CHECK ((quantity > (0)::numeric))"
  },
  {
   "table_name": "devolution_items",
   "conname": "devolution_items_total_check",
   "contype": "c",
   "def": "CHECK ((total >= (0)::numeric))"
  },
  {
   "table_name": "devolution_items",
   "conname": "devolution_items_unit_price_check",
   "contype": "c",
   "def": "CHECK ((unit_price >= (0)::numeric))"
  },
  {
   "table_name": "devolution_items",
   "conname": "devolution_items_devolution_id_fkey",
   "contype": "f",
   "def": "FOREIGN KEY (devolution_id) REFERENCES devolutions(id) ON DELETE CASCADE"
  },
  {
   "table_name": "devolution_items",
   "conname": "devolution_items_product_id_fkey",
   "contype": "f",
   "def": "FOREIGN KEY (product_id) REFERENCES products(id) ON DELETE RESTRICT"
  },
  {
   "table_name": "devolution_items",
   "conname": "devolution_items_pkey",
   "contype": "p",
   "def": "PRIMARY KEY (id)"
  },
  {
   "table_name": "devolutions",
   "conname": "devolutions_payment_method_check",
   "contype": "c",
   "def": "CHECK ((payment_method = ANY (ARRAY['cash'::text, 'transfer'::text, 'zelle'::text, 'store_credit'::text])))"
  },
  {
   "table_name": "devolutions",
   "conname": "devolutions_status_check",
   "contype": "c",
   "def": "CHECK ((status = ANY (ARRAY['pending'::text, 'completed'::text, 'voided'::text, 'reversed'::text])))"
  },
  {
   "table_name": "devolutions",
   "conname": "devolutions_total_amount_check",
   "contype": "c",
   "def": "CHECK ((total_amount >= (0)::numeric))"
  },
  {
   "table_name": "devolutions",
   "conname": "devolutions_customer_id_fkey",
   "contype": "f",
   "def": "FOREIGN KEY (customer_id) REFERENCES customers(id) ON DELETE SET NULL"
  },
  {
   "table_name": "devolutions",
   "conname": "devolutions_original_transaction_id_fkey",
   "contype": "f",
   "def": "FOREIGN KEY (original_transaction_id) REFERENCES transactions(id) ON DELETE SET NULL"
  },
  {
   "table_name": "devolutions",
   "conname": "devolutions_processed_by_fkey",
   "contype": "f",
   "def": "FOREIGN KEY (processed_by) REFERENCES profiles(id)"
  },
  {
   "table_name": "devolutions",
   "conname": "devolutions_reversed_by_fkey",
   "contype": "f",
   "def": "FOREIGN KEY (reversed_by) REFERENCES profiles(id)"
  },
  {
   "table_name": "devolutions",
   "conname": "devolutions_store_id_fkey",
   "contype": "f",
   "def": "FOREIGN KEY (store_id) REFERENCES stores(id) ON DELETE CASCADE"
  },
  {
   "table_name": "devolutions",
   "conname": "devolutions_voided_by_fkey",
   "contype": "f",
   "def": "FOREIGN KEY (voided_by) REFERENCES profiles(id)"
  },
  {
   "table_name": "devolutions",
   "conname": "devolutions_pkey",
   "contype": "p",
   "def": "PRIMARY KEY (id)"
  }
 ],
