{
 "policies": [
  {
   "policyname": "Audit logs select",
   "cmd": "SELECT",
   "roles": "{authenticated}",
   "permissive": "PERMISSIVE",
   "qual": "(( SELECT profiles.role\n   FROM profiles\n  WHERE (profiles.id = ( SELECT auth.uid() AS uid))) = 'admin'::user_role)",
   "with_check": ""
  },
  {
   "policyname": "audit_logs_insert_authenticated",
   "cmd": "INSERT",
   "roles": "{authenticated}",
   "permissive": "PERMISSIVE",
   "qual": "",
   "with_check": "(user_id = auth.uid())"
  },
  {
   "policyname": "audit_logs_select_own_and_managed",
   "cmd": "SELECT",
   "roles": "{authenticated}",
   "permissive": "PERMISSIVE",
   "qual": "(is_global_admin() OR ((store_id IS NOT NULL) AND has_store_role(store_id, ARRAY['admin'::text, 'manager'::text, 'encargado'::text])))",
   "with_check": ""
  }
 ],
 "triggers": [
  {
   "tgname": "trg_set_audit_log_trace_id",
   "enabled": "enabled",
   "fn": "set_audit_log_trace_id",
   "def": "CREATE TRIGGER trg_set_audit_log_trace_id BEFORE INSERT ON public.audit_logs FOR EACH ROW EXECUTE FUNCTION set_audit_log_trace_id()"
  },
  {
   "tgname": "update_audit_logs_updated_at",
   "enabled": "enabled",
   "fn": "update_updated_at_column",
   "def": "CREATE TRIGGER update_audit_logs_updated_at BEFORE UPDATE ON public.audit_logs FOR EACH ROW EXECUTE FUNCTION update_updated_at_column()"
  }
 ],
