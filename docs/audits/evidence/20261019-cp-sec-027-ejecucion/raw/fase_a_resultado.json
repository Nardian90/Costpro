    "statements": [
      {
        "n": 1,
        "ok": true,
        "sql": "CREATE OR REPLACE VIEW public.public_catalog_v WITH (security_barrier = true) AS SELECT p.id, p.store_id, p.name, p.description, p.sku, p.price, p.price_currency, p.price_visible, p.stock_visible, p.stock_current, p.on_promotion, p.unit_of_measure, p.image_url, p.public_image_url, p.category, p.is_active, p.visible_en_tienda FROM public.products p WHERE p.is_active = true AND p.visible_en_tienda = true",
        "filas": 0
      },
      {
        "n": 2,
        "ok": true,
        "sql": "CREATE OR REPLACE VIEW public.public_storefronts_v WITH (security_barrier = true) AS SELECT s.id, s.name, s.address, s.phone, s.email, s.logo_url, s.slug, s.plantilla, s.reeup, s.is_active, s.banner_url, s.store_tagline, s.whatsapp_group_url, s.telegram_url, s.services, s.promo_images, s.opening_hours, s.banner_cta_text, s.banner_cta_link FROM public.stores s WHERE s.is_active = true",
        "filas": 0
      },
      {
        "n": 3,
        "ok": true,
        "sql": "CREATE OR REPLACE VIEW public.public_variants_v WITH (security_barrier = true) AS SELECT v.id, v.product_id, v.name, v.sku, v.price, v.conversion_factor FROM public.product_variants v WHERE EXISTS ( SELECT 1 FROM public.products p WHERE p.id = v.product_id AND p.is_active = true AND p.visible_en_tienda = true )",
        "filas": 0
      },
      {
        "n": 4,
        "ok": true,
        "sql": "GRANT SELECT ON public.public_catalog_v TO anon",
